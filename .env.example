# Zoho Mail SMTP credentials used by app/api/contact/route.ts
# ZOHO_SMTP_USER: the full Zoho mailbox address that sends the mail (e.g. hello@fenwebstudio.com)
# ZOHO_SMTP_PASSWORD: an app-specific password, NOT your regular Zoho login password
#   Generate one at https://accounts.zoho.com/home#security/app-passwords
#   (Zoho requires this once 2FA is enabled — enable 2FA first if SMTP login fails)
# ZOHO_SMTP_HOST / ZOHO_SMTP_PORT: optional overrides; defaults to smtp.zoho.com:465
#   (use smtp.zoho.eu instead if your Zoho account is on the EU data center)
# CONTACT_TO_EMAIL: where contact form messages are delivered (defaults to ZOHO_SMTP_USER if unset)
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
CONTACT_TO_EMAIL=hello@fenwebstudio.com
