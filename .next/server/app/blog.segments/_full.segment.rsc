13:[["$","title","0",{"children":"Notes from the studio — Fen Web Studio"}],["$","meta","1",{"name":"description","content":"Short, occasional notes on design, upkeep, and what actually moves the needle for a small business site."}],["$","meta","2",{"name":"robots","content":"index, follow"}],["$","link","3",{"rel":"canonical","href":"https://fenwebstudio.com/blog"}],["$","meta","4",{"property":"og:title","content":"Fen Web Studio — Elegant Websites for Small Businesses"}],["$","meta","5",{"property":"og:description","content":"Fen Web Studio designs elegant, no-clutter websites for small and medium businesses, then keeps them polished with a monthly care plan."}],["$","meta","6",{"property":"og:url","content":"https://fenwebstudio.com"}],["$","meta","7",{"property":"og:site_name","content":"Fen Web Studio"}],["$","meta","8",{"property":"og:type","content":"website"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Fen Web Studio — Elegant Websites for Small Businesses"}],["$","meta","11",{"name":"twitter:description","content":"Fen Web Studio designs elegant, no-clutter websites for small and medium businesses, then keeps them polished with a monthly care plan."}],["$","link","12",{"rel":"icon","href":"/icon.svg?icon.43sy2d0dcndv_.svg","sizes":"any","type":"image/svg+xml"}],["$","$L14","13",{}]]
